# ===== Salin menjadi .env =====
# Database
POSTGRES_PASSWORD=ganti_dengan_password_kuat
# Keamanan (WAJIB diganti di produksi: openssl rand -hex 32)
JWT_SECRET=ganti_dengan_secret_acak_minimal_32_karakter
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=Admin123!

# ===== LLM =====
# mock   = mode demo tanpa API key (jawaban ekstraktif + planner agent berbasis aturan)
# openai = LLM sungguhan (OpenAI atau API OpenAI-compatible: Ollama, vLLM, Groq, Azure gateway, dll)
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Contoh Ollama lokal: LLM_PROVIDER=openai, OPENAI_BASE_URL=http://host.docker.internal:11434/v1, LLM_MODEL=llama3.1

# ===== Embedding =====
# local = hashing deterministik (tanpa unduhan, cocok demo) | openai | sentence_transformers
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=384
# Catatan: mengubah EMBEDDING_DIM / provider setelah ada data => hapus volume (docker compose down -v) atau reindex.

AUTO_SEED=true
